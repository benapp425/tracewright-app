# Copy to .env, fill in, `chmod 600 .env`. Never commit .env.

# The password for signing in (at least 12 characters). Required.
TW_PASSWORD=

# How Claude signs in -- one of:
#   a Claude Pro/Max plan token: run `claude setup-token` on your Mac and paste it here (uses your plan)
CLAUDE_CODE_OAUTH_TOKEN=
#   or an Anthropic API key (billed per token)
# ANTHROPIC_API_KEY=

# Optional: push / pull projects to GitHub (fine-grained token: Contents + Administration read/write)
TW_GITHUB_TOKEN=

# The domain pointing at this server, for HTTPS through Caddy (skip if you use Tailscale)
TW_DOMAIN=tracewright.example.com
